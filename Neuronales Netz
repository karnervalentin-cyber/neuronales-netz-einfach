def loss(daten):

    loss = 0
    
    for i in daten.values():
        inputs = [i["input1"], i["input2"], i["input3"]]
        loss += (netz_berechnung(inputs) - i["output"])**2
    return loss

    
def make_loss_function(layer, Neuron, gewicht, daten, layers):
    
    
    def f(x):
        original_wert = layers[layer].Neuronen[Neuron].gewichte[gewicht]
        layers[layer].Neuronen[Neuron].gewichte[gewicht] = x
        loss_value = loss(daten)
        layers[layer].Neuronen[Neuron].gewichte[gewicht] = original_wert
        
        return loss_value
    
    
    return f

def make_loss_function_bias(layer, Neuron, daten, layers):
    
    def f(x):
        original_wert = layers[layer].Neuronen[Neuron].bias
        layers[layer].Neuronen[Neuron].bias = x
        loss_value = loss(daten)
        layers[layer].Neuronen[Neuron].bias = original_wert
        return loss_value
    
    return f

def gradient_descent(n_layer, n_Neuron, n_gewicht, daten, layers):
    layer = layers[n_layer]
    loss_function = make_loss_function(n_layer, n_Neuron, n_gewicht, daten, layers)
    
    original_wert = layer.Neuronen[n_Neuron].gewichte[n_gewicht]
    ableitung = deriv(loss_function, original_wert)
    
    return original_wert - 0.1 * ableitung

def gradient_descent_bias(n_layer, n_Neuron, daten, layers):
    layer = layers[n_layer]
    loss_function = make_loss_function_bias(n_layer, n_Neuron, daten, layers)
    original_wert = layer.Neuronen[n_Neuron].bias
    ableitung = deriv(loss_function, original_wert)
    
    return original_wert - 0.1 * ableitung
    



def epoche(daten, layers):
    n_layer = 0
    for layer in layers:
        n_Neuron = 0
        
        for Neuron in layer.Neuronen:
            n_gewicht = 0
            
            for gewicht in Neuron.gewichte:
                layers[n_layer].Neuronen[n_Neuron].gewichte[n_gewicht] = gradient_descent(n_layer, n_Neuron, n_gewicht, daten, layers)
                
                n_gewicht += 1
            layers[n_layer].Neuronen[n_Neuron].bias = gradient_descent_bias(n_layer, n_Neuron, daten, layers)
            n_Neuron += 1
        n_layer += 1
    






