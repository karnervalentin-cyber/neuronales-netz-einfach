import random as rand


def relu(x):
    if x > 0:
        return x
    else:
        return x / 100
      

class Neuron:
    def __init__(self, anzahl_inputs, is_first_layer):
        gewichte = []
        if is_first_layer == True:
            pass
        else:
            for i in range(0, anzahl_inputs):
                gewichte.append(rand.uniform(-1, 1))
            
        self.gewichte = gewichte
        self.bias = rand.uniform(-1, 1)
        self.value = None
        self.ableitung = None
    

                

class Layer:
    def __init__(self, n_layer, anzahl_neuronen, anzahl_inputs, input_layer):
        if n_layer == 0:
            is_first_layer = True
        else:
            is_first_layer = False
            
        Neuronen = []
        for i in range(0, anzahl_neuronen):
            Neuronen.append(Neuron(anzahl_inputs, is_first_layer))
        
        self.Neuronen = Neuronen
        self.n_layer = n_layer
        self.input_layer = input_layer
        
    def berechnung(self):
        if self.n_layer == 0:
            pass
        elif self.n_layer == 3:
            summe = 0
            n_input_Neuron = 0
            for input_Neuron in self.input_layer.Neuronen:
                summe += input_Neuron.value * self.Neuronen[0].gewichte[n_input_Neuron]
                n_input_Neuron += 1
            self.Neuronen[0].value = summe + self.Neuronen[0].bias
        else:
            for Neuron in self.Neuronen:
                summe = 0
                n_input_Neuron = 0
                for input_Neuron in self.input_layer.Neuronen:
                    summe += input_Neuron.value * Neuron.gewichte[n_input_Neuron]
                    n_input_Neuron += 1
                Neuron.value = relu(summe + Neuron.bias)
                
            
        
def netz_berechnung(inputs, layers):
    for i in range (0,3):
        layers[0].Neuronen[i].value = inputs[i]
    layers[1].berechnung()
    layers[2].berechnung()
    layers[3].berechnung()
    return layers[3].Neuronen[0].value





def back_propagation(datensatz, layers):
    inputs = [datensatz["input1"], datensatz["input2"], datensatz["input3"]]
    Prediction = netz_berechnung(inputs, layers)
    layers[3].Neuronen[0].ableitung = 2 * (Prediction - datensatz["output"])
    loss = (Prediction - datensatz["output"])**2
    
    
    for n_Layer in range(len(layers)-2, 0, -1):
        for n_Neuron in range(len(layers[n_Layer].Neuronen)):
            summe_ableitungen = 0
            for n_Neuron_vorne in range(len(layers[n_Layer + 1].Neuronen)):
                summe_ableitungen += layers[n_Layer + 1].Neuronen[n_Neuron_vorne].ableitung * layers[n_Layer + 1].Neuronen[n_Neuron_vorne].gewichte[n_Neuron]
            if layers[n_Layer].Neuronen[n_Neuron].value > 0:
                layers[n_Layer].Neuronen[n_Neuron].ableitung = summe_ableitungen
            else:
                layers[n_Layer].Neuronen[n_Neuron].ableitung = 0
    
    return loss

def gradient_descent(layers, learnrate):
    for n_Layer in range(1, len(layers)):
        for n_Neuron in range(len(layers[n_Layer].Neuronen)):
            for n_gewicht in range(len(layers[n_Layer].Neuronen[n_Neuron].gewichte)):
                layers[n_Layer].Neuronen[n_Neuron].gewichte[n_gewicht] -= layers[n_Layer].Neuronen[n_Neuron].ableitung * layers[n_Layer-1].Neuronen[n_gewicht].value * learnrate
            layers[n_Layer].Neuronen[n_Neuron].bias -= layers[n_Layer].Neuronen[n_Neuron].ableitung * learnrate
            
            
