import random as rand
import math as m


def relu(x):
    if x > 0:
        return x
    else:
        return 0
    
def deriv(f, x, h=10**-6):
    return (f(x + h) - f(x))/h
    

class Neuron:
    def __init__(self, anzahl_inputs, is_first_layer):
        gewichte = []
        if is_first_layer == True:
            pass
        else:
            for i in range(0, anzahl_inputs):
                gewichte.append(rand.uniform(-1, 1))
            
        self.gewichte = gewichte
        self.bias = rand.uniform(-1, 1)
        self.value = 0
    

                

class Layer:
    def __init__(self, n_layer, anzahl_neuronen, anzahl_inputs, input_layer, is_first_layer):
        Neuronen = []
        for i in range(0, anzahl_neuronen):
            Neuronen.append(Neuron(anzahl_inputs, is_first_layer))
        
        self.Neuronen = Neuronen
        self.is_first_layer = is_first_layer
        self.input_layer = input_layer
        
    def berechnung(self):
        if self.is_first_layer == False:
            for Neuron in self.Neuronen:
                summe = 0
                n_input_Neuron = 0
                for input_Neuron in self.input_layer.Neuronen:
                    summe += input_Neuron.value * Neuron.gewichte[n_input_Neuron]
                    n_input_Neuron += 1
                Neuron.value = relu(summe + Neuron.bias)
                
        else:
            n = 0
            for Neuron in self.Neuronen:
                Neuron.value = self.input_layer[n]
                n += 1
                
            
        
def netz_berechnung(inputs):
    
